p_binder":{"name":"get","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get",0]}],"span":{"data":{"file_id":9,"beg":{"line":171,"col":4},"end":{"line":171,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a shared reference to the output at this location, if in"},{"DocComment":" bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3772},{"HashConsedValue":[3796,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":3773},"Shared"]}]}],"output":{"HashConsedValue":[3798,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[{"HashConsedValue":[3797,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":3784},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[8,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"get_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["get_mut",0]}],"span":{"data":{"file_id":9,"beg":{"line":176,"col":4},"end":{"line":176,"col":65}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, if in"},{"DocComment":" bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3772},{"HashConsedValue":[3799,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":3773},"Mut"]}]}],"output":{"HashConsedValue":[3801,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[{"HashConsed